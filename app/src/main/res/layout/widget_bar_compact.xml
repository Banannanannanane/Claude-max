<?xml version="1.0" encoding="utf-8"?>
<!--
  One-row bar: a single bitmap plus two touch zones. The 700/300 split must stay in
  sync with BarLayout.ACTION_ZONE_FRACTION, which is what draws the LV UP button
  under the right-hand zone.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="1000">

        <FrameLayout
            android:id="@+id/zone_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="700"
            android:contentDescription="@string/zone_open"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/zone_level"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="300"
            android:contentDescription="@string/zone_level"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
