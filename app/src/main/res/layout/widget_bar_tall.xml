<?xml version="1.0" encoding="utf-8"?>
<!--
  Two rows and up: the room fills the top and opens the game; the deck along the
  bottom carries three real buttons.

  Two numbers are a contract with BarLayout, which paints what these zones cover:
  the 48dp deck height is BarLayout.DECK_HEIGHT_DP, and the 280/240/240/240 weights
  are BarLayout.DECK_SPLIT.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/zone_open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/zone_open"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="1000">

            <FrameLayout
                android:id="@+id/zone_level"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="280"
                android:contentDescription="@string/zone_level"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/zone_potion"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="240"
                android:contentDescription="@string/zone_potion"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/zone_cube"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="240"
                android:contentDescription="@string/zone_cube"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/zone_auto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="240"
                android:contentDescription="@string/zone_auto"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
