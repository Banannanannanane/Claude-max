<?xml version="1.0" encoding="utf-8"?>
<!--
  The one-row bar. The bitmap is the whole widget; the two transparent views on
  top of it are the only thing a widget can be tapped on. Their weights are what
  BarLayout.ACTION_FRACTION paints against — change one and the button stops
  being where it looks.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <FrameLayout
            android:id="@+id/open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="720" />

        <FrameLayout
            android:id="@+id/slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="280" />
    </LinearLayout>
</FrameLayout>
