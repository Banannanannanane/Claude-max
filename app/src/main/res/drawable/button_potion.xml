<?xml version="1.0" encoding="utf-8"?>
<!-- Heal button: same slab as the rest, trimmed in health red. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tbh_stone_dark" />
            <stroke android:width="2dp" android:color="@color/tbh_bevel_dark" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tbh_hp" />
            <stroke android:width="2dp" android:color="@color/tbh_parchment" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tbh_stone_dark" />
            <stroke android:width="2dp" android:color="@color/tbh_hp" />
        </shape>
    </item>
</selector>
