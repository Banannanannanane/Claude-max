<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Unaffordable levels dim out rather than disappear, so the price stays readable. -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/tbh_dim" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/tbh_red" />
            <solid android:color="@color/tbh_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke android:width="1.5dp" android:color="@color/tbh_red" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
