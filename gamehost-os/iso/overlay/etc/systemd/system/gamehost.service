[Unit]
Description=GameHost Panel (interface web de gestion des serveurs de jeux)
After=network-online.target
Wants=network-online.target
# indépendant de gamehost-firstboot : le panneau démarre tout de suite,
# le provisionnement (pare-feu, Claude Code) se fait en parallèle.

[Service]
Type=simple
ExecStart=/opt/gamehost/panel -listen :8080 -data /var/lib/gamehost -srv /srv/gamehost -config /etc/gamehost/config.json
Restart=always
RestartSec=3
# durcissement léger — le panneau tourne en root pour gérer systemd/steamcmd,
# mais on limite la casse.
NoNewPrivileges=false
ProtectHome=false
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
